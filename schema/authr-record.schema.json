{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identient.github.io/authr/schema/authr-record-v0.1.json",
  "title": "AuthR Record v0.1",
  "description": "Schema for AuthR (Authorship Representation) records per the v0.1 specification.",
  "type": "object",
  "required": [
    "authr_id",
    "version",
    "issued_at",
    "expires_at",
    "author",
    "actor",
    "intent",
    "scope",
    "provenance",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "authr_id": {
      "type": "string",
      "description": "Globally unique identifier in URN form.",
      "pattern": "^urn:authr:[A-Za-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "description": "Specification version.",
      "const": "0.1"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when the record was issued."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp after which the record is no longer valid."
    },
    "author": {
      "type": "object",
      "required": ["id", "type", "grounding"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier (DID, SPIFFE ID, or other URI)."
        },
        "type": {
          "type": "string",
          "enum": ["verified_human", "verified_digital_twin", "organization", "committee"]
        },
        "role": {
          "type": "string",
          "description": "Role of the author within their organization."
        },
        "display_name": {
          "type": "string"
        },
        "grounding": {
          "type": "object",
          "required": ["referent_type", "verified_at", "verifier", "evidence_digest"],
          "additionalProperties": false,
          "properties": {
            "referent_type": {
              "type": "string",
              "enum": ["verified_human", "verified_organization", "verified_committee"]
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            },
            "verifier": {
              "type": "string",
              "description": "Identifier of the system that verified the referent."
            },
            "evidence_digest": {
              "type": "string",
              "description": "Hash of the grounding evidence (e.g., sha256:...).",
              "pattern": "^(sha256|sha384|sha512):[a-fA-F0-9]+$"
            }
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier (SPIFFE ID recommended for workloads)."
        },
        "type": {
          "type": "string",
          "enum": ["agent", "ai_worker", "orchestrator", "tool", "human_operator"]
        },
        "model_manifest": {
          "type": "object",
          "required": ["code_hash", "model_hash", "model_version", "signer_id"],
          "additionalProperties": false,
          "properties": {
            "code_hash": {
              "type": "string",
              "pattern": "^(sha256|sha384|sha512):[a-fA-F0-9]+$"
            },
            "model_hash": {
              "type": "string",
              "pattern": "^(sha256|sha384|sha512):[a-fA-F0-9]+$"
            },
            "model_version": {
              "type": "string"
            },
            "signer_id": {
              "type": "string"
            }
          }
        },
        "attestation": {
          "type": "object",
          "required": ["type", "evidence_digest", "verified_at"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["tee_tdx", "tee_sgx", "tee_sev_snp", "spiffe_svid", "platform_attestation"]
            },
            "evidence_digest": {
              "type": "string",
              "pattern": "^(sha256|sha384|sha512):[a-fA-F0-9]+$"
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "required": ["purpose", "statement", "risk_tier", "human_in_the_loop"],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string",
          "description": "Canonical purpose label from a controlled vocabulary."
        },
        "statement": {
          "type": "string",
          "description": "Natural-language statement of intent in the Author's words.",
          "minLength": 1
        },
        "risk_tier": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "human_in_the_loop": {
          "type": "boolean"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["actions", "resources"],
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "max_amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string" },
            "max_delegation_depth": { "type": "integer", "minimum": 0 },
            "valid_window_minutes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["chain", "correlation_id"],
      "additionalProperties": false,
      "properties": {
        "chain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["authr_id", "depth", "issuer"],
            "additionalProperties": false,
            "properties": {
              "authr_id": { "type": "string", "pattern": "^urn:authr:[A-Za-z0-9._-]+$" },
              "depth": { "type": "integer", "minimum": 1 },
              "issuer": { "type": "string" }
            }
          }
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "data_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "source_hash", "source_type"],
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string" },
              "source_hash": { "type": "string", "pattern": "^(sha256|sha384|sha512):[a-fA-F0-9]+$" },
              "source_type": { "type": "string", "enum": ["policy", "dataset", "ruling", "document", "credential"] }
            }
          }
        }
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stale_after": {
          "type": "string",
          "format": "date-time"
        },
        "deviation_signals": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "revocation": {
      "type": "object",
      "required": ["status_endpoint"],
      "additionalProperties": false,
      "properties": {
        "status_endpoint": {
          "type": "string",
          "format": "uri"
        },
        "check_required": {
          "type": "boolean"
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["alg", "kid", "value"],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "string",
          "enum": ["EdDSA", "ES256", "RS256"],
          "description": "EdDSA (Ed25519) is REQUIRED at v0.1. Others are optional."
        },
        "kid": {
          "type": "string",
          "description": "Key identifier resolvable in the relying party's trust store."
        },
        "value": {
          "type": "string",
          "description": "Base64url-encoded signature over the canonicalized record minus this field."
        }
      }
    }
  }
}
